{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.2",
  "default_agent": "nauti-builder",
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    }
  },
  "snapshot": false,
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "nauti-builder": {
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "webfetch": "deny"
      },
      "tools": {
        "*": false,
        "generate_prompts": true
      }
    }
  }
}
